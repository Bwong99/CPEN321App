# Server configuration
PORT=3000
NODE_ENV=development

# Public IP reported by GET /api/ip. Required in a cloud deployment: an
# instance behind NAT cannot discover its own public address. Leave blank for
# local development, where the server scans its network interfaces instead.
SERVER_PUBLIC_IP=

# Set to true to serve HTTPS using backend/certs/server.crt and
# backend/certs/server.key. M1 requires the app to reach the back-end over
# HTTPS; leave unset for local HTTP development.
ENABLE_HTTPS=

# Database
MONGODB_URI=mongodb://localhost:27017/cpen321

# Google Auth 
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# JWT 
JWT_SECRET=your_jwt_secret_key_here

# Other API keys, secrets, and configurations