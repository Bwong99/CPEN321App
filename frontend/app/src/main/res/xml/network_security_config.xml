<?xml version="1.0" encoding="utf-8"?>
<!--
  The back-end presents a self-signed certificate, which M1 explicitly permits.
  Android will not trust one without being told to, so the certificate is
  pinned here for our own hosts only. Every other host keeps the platform's
  normal CA trust, and cleartext stays off everywhere except local development.
-->
<network-security-config>

    <!-- Deployed back-end (AWS Elastic IP). HTTPS only. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">52.35.22.194</domain>
        <trust-anchors>
            <certificates src="@raw/server_cert" />
        </trust-anchors>
    </domain-config>

    <!-- Local development. 10.0.2.2 is the emulator's alias for the host
         machine. Cleartext is allowed here so the app can also be run against
         a back-end started without ENABLE_HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <trust-anchors>
            <certificates src="@raw/server_cert" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <base-config cleartextTrafficPermitted="false" />

</network-security-config>
